<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.koretide.app.ui.tidewatch.TideWatchView
        android:id="@+id/tideWatchView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Station info overlay -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/overlayCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_md"
        app:cardBackgroundColor="#AA000000"
        app:cardCornerRadius="@dimen/card_radius"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_sm">

            <TextView
                android:id="@+id/tvStationName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTideInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvWindInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CC81D4FA"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvMudflatGrade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CC90EE90"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 정보 로딩 표시 (관측소 데이터 가져오는 중) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardWatchLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_md"
        android:visibility="gone"
        app:cardBackgroundColor="#AA000000"
        app:cardCornerRadius="@dimen/card_radius"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_sm">

            <ProgressBar
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:indeterminateTint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌊 정보를 가져오는 중…"
                android:textColor="@android:color/white"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Wind / Tide slider panel -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/sliderPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_md"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="#CC000000"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_sm">

            <!-- Wind row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:text="바람세기"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seekWind"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="12"
                    android:progress="3" />

                <TextView
                    android:id="@+id/tvWindBft"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:text="3 bft"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:gravity="end" />
            </LinearLayout>

            <!-- Tide row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:text="물때"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seekTide"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="55" />

                <TextView
                    android:id="@+id/tvTidePct"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:text="55%"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:gravity="end" />
            </LinearLayout>

            <!-- Tidal range (조차) row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:text="조차"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seekTidalRange"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="45" />

                <TextView
                    android:id="@+id/tvTidalRange"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:text="4.5m"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:gravity="end" />
            </LinearLayout>

            <!-- Wave-sound row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/wave_sound_label"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchSound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImmersive"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="초기화"
                android:textColor="@android:color/white"
                app:strokeColor="#55FFFFFF" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
