<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <!-- ── Screen 1: Index Type List ─────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/screenTypeList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_xs">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="해양 활동 지수"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="?android:textColorPrimary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIndexInfo"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="ℹ"
                    android:textSize="18sp"
                    android:padding="0dp"
                    app:iconPadding="0dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStationHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="?android:textColorSecondary"
                android:layout_marginBottom="@dimen/spacing_md" />

            <ProgressBar
                android:id="@+id/progressTypeList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/containerTypeList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── Screen 2: Region Grade List ──────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/screenRegionList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_md">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackFromRegion"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="‹"
                    android:textSize="22sp"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="8dp"
                    app:iconPadding="0dp" />

                <TextView
                    android:id="@+id/tvRegionListTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?android:textColorPrimary" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressRegionList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/containerRegionList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── Screen 3: Beach List ──────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/screenBeachList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_md">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackFromBeach"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="‹"
                    android:textSize="22sp"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="8dp"
                    app:iconPadding="0dp" />

                <TextView
                    android:id="@+id/tvBeachListTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?android:textColorPrimary" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBeachList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/containerBeachList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
