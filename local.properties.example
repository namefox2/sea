# local.properties 템플릿
#
# 실제 local.properties 는 .gitignore 에 포함되어 git 에 올라가지 않습니다(비밀 정보).
# 저장소를 새로 받거나 환경이 초기화되면 사라지므로, 이 파일을 참고해 다시 만드세요.
#
# 사용법:
#   1) 이 파일을 local.properties 로 복사
#   2) 아래 값들을 실제 발급받은 키로 채우기
#   (sdk.dir 은 Android Studio 가 Gradle Sync 시 자동으로 넣어줍니다)

# Android SDK 경로 (Android Studio 가 자동 생성 — 직접 넣지 않아도 됨)
# sdk.dir=/Users/you/Library/Android/sdk

# ── API 키 (비우면 해당 API 호출이 실패합니다) ──────────────────
# 국립해양조사원(KHOA) 오픈API 서비스키 (조위/지수 등)
KHOA_API_KEY=

# 기상청(KMA) 서비스키
KMA_API_KEY=

# 해수욕장/해양활동 지수 서비스키
BEACH_API_KEY=

# 한국천문연구원(KASI) 일출·일몰 서비스키
KASI_API_KEY=

# ── 네이버 지도 ───────────────────────────────────────────────
# 네이버 클라우드 플랫폼 Maps 클라이언트 ID (없으면 코드의 기본값 사용)
NAVER_CLIENT_ID=
